{
  "name": "file-ignore",
  "version": "1.1.3",
  "description": "Control files indexing by adding or removing dot prefix to files, providing a .gitignore-like experience",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "debug": "node --inspect-brk esbuild.config.mjs",
    "lint": "eslint src package.json --max-warnings 0 && node scripts/check-manifest.mjs",
    "lint:css": "stylelint styles.css --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "release:check": "node scripts/preflight.cjs",
    "release:tag": "node scripts/tag-release.cjs",
    "release:verify": "node scripts/verify-release.cjs"
  },
  "keywords": [
    "obsidian-plugin"
  ],
  "author": "Chen",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.0.0",
    "esbuild": "0.27.4",
    "eslint": "^9.39.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.8.7",
    "stylelint": "^17.0.0",
    "stylelint-config-obsidianmd": "0.1.0",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "minimatch": "5.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
